# ---------------------------------------------------------------------------
# Planning Poker — backend environment
# Copy to `.env` and fill in real values. NEVER commit the populated file.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins for CORS / Socket.IO
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://poker:poker@localhost:5432/planning_poker?schema=public

# JWT / auth secrets — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Azure AD / Microsoft Entra ID (optional SSO)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Google OAuth (optional SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jira Cloud integration (optional)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Outbound notifications (optional)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
SMTP_URL=
